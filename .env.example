# Baza (Neoserv MySQL/MariaDB) – oddaljeni dostop mora biti dovoljen
DB_HOST=sqlXXX.neoserv.si
DB_PORT=3306
DB_USER=moj_uporabnik
DB_PASSWORD=moje_geslo
DB_NAME=moja_baza
DB_SSL=1
DB_SSL_REJECT_UNAUTHORIZED=0

# Seje (dolg naključen niz – node scripts/keygen.js)
SESSION_SECRET=zamenjaj_me

# Enkratni žeton za /api/setup (ustvari tabele + osebi). Po namestitvi izbriši.
SETUP_TOKEN=zamenjaj_me

# Privzeta valuta in časovni pas
CURRENCY=EUR
